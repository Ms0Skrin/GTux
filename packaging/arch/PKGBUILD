# Maintainer: Евгений <111508528+Ms0Skrin@users.noreply.github.com>
# Сборка: scripts/build_arch_package.sh (делает архив исходников из git и запускает makepkg)

pkgname=linux-gamer-doctor
pkgver=0.3.0
pkgrel=1
pkgdesc="Checks a Linux system and explains in plain words what is missing for gaming"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python>=3.11' 'python-rich')
optdepends=(
  'gtk4: graphical window (--gui)'
  'libadwaita: graphical window (--gui)'
  'python-gobject: graphical window (--gui)'
  'vulkan-tools: check that Vulkan sees the GPU (vulkaninfo)'
  'pciutils: readable GPU names (lspci)'
  'polkit: fix problems from the window (pkexec)'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')  # архив собирается локально из git, а не скачивается

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local site
  site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')

  # модули программы + данные (базы игр и античитов)
  install -d "$pkgdir$site"
  cp -r doctor "$pkgdir$site/"
  find "$pkgdir$site/doctor" -name '__pycache__' -prune -exec rm -rf {} +
  python -m compileall -q -s "$pkgdir" "$pkgdir$site/doctor"
  python -O -m compileall -q -s "$pkgdir" "$pkgdir$site/doctor"

  # команда linux-gamer-doctor
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/linux-gamer-doctor" <<'SH'
#!/bin/sh
exec /usr/bin/python3 -m doctor "$@"
SH

  # ярлык в меню и иконка (имя совпадает с application id окна — так GNOME связывает окно с иконкой)
  install -Dm644 data/io.github.lgdoctor.LinuxGamerDoctor.desktop \
    "$pkgdir/usr/share/applications/io.github.lgdoctor.LinuxGamerDoctor.desktop"
  install -Dm644 data/io.github.lgdoctor.LinuxGamerDoctor.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.lgdoctor.LinuxGamerDoctor.svg"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 doctor/data/ANTICHEAT_LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/ANTICHEAT_LICENSE.txt"
}
